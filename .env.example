# ─────────────────────────────────────────────
# gpgshare — local configuration
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must NEVER be committed.
# ─────────────────────────────────────────────

# Absolute (or ~-relative) path to your private GPG key file.
# Export it with: gpg --armor --export-secret-keys your@email.com > ~/my-private-key.asc
GPG_PRIVATE_KEY_PATH=~/.gnupg/my-private-key.asc

# The email address associated with your private key.
# This is used to select the correct key for signing.
GPG_SIGNER_EMAIL=you@yourcompany.com

# Optional: custom GPG home directory.
# Leave empty to use the system default (~/.gnupg).
GPG_HOME=

# Optional overrides — defaults work fine for most setups.
# KEYS_DIR=./keys
# COLLABORATORS_FILE=./collaborators.yaml

# Si es True, ignora el keyring del sistema y solo usa GPG_PRIVATE_KEY_PATH.
# Si es False o no está definido, usa todas las claves del keyring (~/.gnupg).
# KEYRING_DISABLED=True

# Interface language: 'en' (English, default) or 'es' (Spanish).
# LANGUAGE=en